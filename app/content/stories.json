        { "nl": "\"Waar woon je?\" vraagt Monia.", "fr": "« Où habites-tu ? » demande Monia." },
        { "nl": "\"Ik woon in Gent. En jij?\"", "fr": "« J'habite à Gand. Et toi ? »" },
